<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="description" content="STYLE HUB 风格衣橱 — 你的私人时尚 AI 造型师。旧衣新穿跟上潮流，每日 OOTD、折扣情报与省钱成就一站搞定。">
<title>STYLE HUB · 风格衣橱 — 你的私人时尚 AI 造型师</title>
<style>
/* ============ 设计变量：奶油白 × 墨黑 × 香槟金 × 裸粉 ============ */
:root{
  --cream:#FBF8F4; --card:#FFFFFF; --ink:#1C1A17; --ink-soft:#5A5348;
  --gold:#B08D57; --gold-deep:#96784A; --gold-light:#D6BC8E; --line:#E9E0D2;
  --rose:#D9A38F; --rose-soft:#F3E4DB; --night:#171310; --night-2:#221C17;
  --red:#C0564F; --red-soft:#F7E5E3; --green:#5F8050; --green-soft:#E8EFE2;
  --amber:#B97F2A; --amber-soft:#F8EDDA;
  --serif:Georgia,'Songti SC','STSong','SimSun','Times New Roman',serif;
  --sans:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',Roboto,sans-serif;
  --shadow:0 10px 40px rgba(28,26,23,.08); --radius:18px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{font-family:var(--sans);background:var(--cream);background-image:radial-gradient(ellipse 120% 80% at 50% -20%,#F8F0E6 0%,transparent 55%);color:var(--ink);line-height:1.6;padding-bottom:env(safe-area-inset-bottom)}
img{max-width:100%}
button{font-family:var(--sans);cursor:pointer;border:none;background:none;font-size:15px}
input,select,textarea{font-family:var(--sans);font-size:16px;color:var(--ink)}
::selection{background:var(--gold-light);color:var(--ink)}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
.eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:700}
h2.sec-title{font-family:var(--serif);font-size:clamp(26px,4vw,38px);font-weight:700;letter-spacing:.02em;margin:8px 0 6px}
.sec-sub{color:var(--ink-soft);font-size:15px;max-width:620px}
.sec-head{margin-bottom:28px}
.sec-num{font-family:var(--serif);font-size:15px;color:var(--gold);letter-spacing:.2em}
.icon{width:18px;height:18px;flex:none;display:inline-block;vertical-align:-3px}
.icon-sm{width:15px;height:15px}
button.btn{min-height:44px;padding:10px 22px;border-radius:999px;font-size:15px;font-weight:600;display:inline-flex;align-items:center;gap:8px;justify-content:center;transition:.2s}
.btn-gold{background:linear-gradient(120deg,#C9A876,#B08D57 60%,#96784A);color:#fff;box-shadow:0 6px 18px rgba(176,141,87,.35)}
.btn-gold:hover{filter:brightness(1.06);transform:translateY(-1px)}
.btn-ink{background:var(--ink);color:#F5EFE6}
.btn-ink:hover{background:#3A342C}
.btn-ghost{border:1px solid var(--line);background:#fff;color:var(--ink)}
.btn-ghost:hover{border-color:var(--gold-light);color:var(--gold-deep)}
.btn-danger{background:#fff;color:var(--red);border:1px solid #E5C6C3}
/* ============ 顶部导航 ============ */
#topbar{position:sticky;top:0;z-index:100;background:rgba(251,248,244,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
#topbar .wrap{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{display:flex;align-items:baseline;gap:10px;text-decoration:none;color:var(--ink)}
.logo b{font-family:var(--serif);font-size:21px;letter-spacing:.12em}
.logo span{font-size:11px;letter-spacing:.3em;color:var(--gold)}
.nav-links{display:flex;gap:6px}
.nav-links a{text-decoration:none;color:var(--ink-soft);font-size:14px;padding:8px 14px;border-radius:999px;transition:.2s;font-weight:500}
.nav-links a:hover{color:var(--ink);background:#fff;box-shadow:inset 0 0 0 1px var(--line)}
#burger{display:none;width:44px;height:44px;align-items:center;justify-content:center;color:var(--ink)}
#mobileNav{display:none;flex-direction:column;padding:6px 24px 16px;border-top:1px dashed var(--line);background:rgba(251,248,244,.97)}
#mobileNav a{text-decoration:none;color:var(--ink);font-size:16px;padding:13px 4px;border-bottom:1px solid #F0E9DC;font-weight:500}
#mobileNav.open{display:flex}
/* ============ Hero ============ */
#hero{position:relative;overflow:hidden;padding:64px 0 0}
.hero-bg{position:absolute;inset:0;pointer-events:none}
.blob{position:absolute;border-radius:50%;filter:blur(64px);opacity:.72;pointer-events:none}
.b1{width:560px;height:560px;background:radial-gradient(circle at 40% 40%,#E8B8A0 0%,#F0C8B4 35%,transparent 68%);top:-180px;right:-100px}
.b2{width:480px;height:480px;background:radial-gradient(circle at 55% 55%,#E6C890 0%,#F0D9A8 40%,transparent 70%);bottom:-160px;left:-140px}
.b3{width:340px;height:340px;background:radial-gradient(circle at 50% 50%,#F2D4C4 0%,#F8E4D8 45%,transparent 72%);top:28%;left:36%;opacity:.78}
.b4{width:280px;height:280px;background:radial-gradient(circle at 50% 50%,#D6BC8E 0%,transparent 70%);top:55%;right:8%;opacity:.45}
.hero-lines{position:absolute;inset:0;background:
  repeating-linear-gradient(115deg,transparent 0 22px,rgba(176,141,87,.07) 22px 23px),
  radial-gradient(ellipse 80% 60% at 70% 20%,rgba(217,163,143,.12),transparent 55%),
  radial-gradient(ellipse 70% 50% at 15% 80%,rgba(176,141,87,.10),transparent 50%);
  pointer-events:none}
.hero-bg{position:absolute;inset:0;pointer-events:none;background:linear-gradient(165deg,#FBF8F4 0%,#F8F1E8 40%,#F6EDE4 100%)}
#hero .wrap{position:relative;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;padding-bottom:56px}
.hero-copy .eyebrow{display:flex;align-items:center;gap:12px}
.hero-copy .eyebrow::after{content:"";height:1px;width:56px;background:var(--gold-light)}
.hero-copy h1{font-family:var(--serif);font-size:clamp(34px,5.2vw,58px);line-height:1.22;font-weight:700;margin:18px 0 16px}
.hero-copy h1 em{font-style:normal;background:linear-gradient(120deg,#B08D57,#D9A38F 70%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-copy p{color:var(--ink-soft);font-size:16px;max-width:480px}
.hero-cta{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}
.hero-tags{display:flex;gap:8px;margin-top:22px;flex-wrap:wrap}
.hero-tags span{font-size:12px;letter-spacing:.1em;border:1px solid var(--line);background:#fff;border-radius:999px;padding:5px 12px;color:var(--ink-soft)}
.hero-stage{position:relative;height:440px}
.float-card{position:absolute;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:14px 16px;width:212px;transition:transform .3s}
.float-card:hover{transform:rotate(0) translateY(-4px)}
.float-card .fc-label{font-size:11px;letter-spacing:.2em;color:var(--gold);font-weight:700;text-transform:uppercase}
.float-card .fc-main{font-family:var(--serif);font-size:20px;font-weight:700;margin-top:4px}
.fc1{top:10px;right:26px;transform:rotate(2.5deg);z-index:3}
.fc2{top:128px;left:0;transform:rotate(-3deg);z-index:2}
.fc2 .cpw-row{display:flex;align-items:center;gap:10px;margin-top:6px}
.fc3{bottom:16px;right:14px;transform:rotate(1.5deg);z-index:4}
.fc3 .fc-main{color:var(--red);font-size:17px}
.sparkle{position:absolute;color:var(--gold);animation:tw 2.6s ease-in-out infinite}
@keyframes tw{0%,100%{opacity:.25;transform:scale(.85)}50%{opacity:1;transform:scale(1.08)}}
.vert-text{position:absolute;left:-6px;bottom:0;writing-mode:vertical-rl;font-size:11px;letter-spacing:.5em;color:var(--gold);opacity:.75;text-transform:uppercase}
/* 跑马灯 */
.ticker{background:var(--ink);color:#EFE8DB;overflow:hidden;white-space:nowrap;padding:12px 0;position:relative;z-index:2}
.ticker-inner{display:inline-block;animation:tick 26s linear infinite;font-size:13px;letter-spacing:.32em;text-transform:uppercase}
.ticker-inner b{color:var(--gold-light);font-weight:600}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){.ticker-inner,.sparkle{animation:none}}
/* ============ 通用区块 ============ */
section{padding:64px 0}
/* ============ 今日风格卡 ============ */
#daily{padding-top:48px}
.today-shell{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:26px;position:relative;overflow:hidden}
.today-shell::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#B08D57,#D9A38F,#E3CD9C)}
.today-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}
.weather{display:flex;align-items:center;gap:12px}
.weather .w-num{font-family:var(--serif);font-size:40px;font-weight:700;line-height:1}
.weather .w-meta{font-size:13px;color:var(--ink-soft)}
.weather .w-city{font-size:12px;letter-spacing:.2em;color:var(--gold);font-weight:700}
.pills{display:flex;gap:8px;flex-wrap:wrap}
.pill{min-height:44px;padding:10px 18px;border-radius:999px;border:1px solid var(--line);background:#fff;color:var(--ink-soft);font-size:14px;font-weight:500;transition:.2s}
.pill.active{background:var(--ink);color:#F5EFE6;border-color:var(--ink)}
.today-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px;align-items:start}
.dcard{border:1px solid var(--line);border-radius:14px;padding:18px;background:linear-gradient(180deg,#FFFDF9,#FAF5EC);display:flex;flex-direction:column}
.dcard .dc-tag{display:flex;align-items:center;gap:8px;font-size:12px;letter-spacing:.18em;color:var(--gold);font-weight:700}
.dcard h4{font-family:var(--serif);font-size:19px;margin:10px 0 8px}
.dcard .dc-note{font-size:13.5px;color:var(--ink-soft)}
.chip-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.chip{font-size:12.5px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:4px 11px;color:var(--ink)}
.chip b{color:var(--gold-deep);font-weight:600}
.today-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:18px;flex-wrap:wrap}
.today-foot .tf-note{font-size:13px;color:var(--ink-soft)}
/* PAO 提醒 & 备份工具 & 数据提示 */
.alert-bar{display:flex;align-items:center;gap:12px;border-radius:14px;padding:14px 18px;margin-bottom:14px;flex-wrap:wrap}
.alert-bar .ab-txt{flex:1;min-width:220px;font-size:14px}
.alert-red{background:var(--red-soft);border:1px solid #E8C6C2;color:#8E3A34}
.alert-amber{background:var(--amber-soft);border:1px solid #E8D6AE;color:#7C551B}
.alert-gold{background:linear-gradient(90deg,#FAF3E4,#F7EDE0);border:1px solid var(--gold-light);color:var(--gold-deep)}
.alert-bar .btn{min-height:38px;padding:6px 16px;font-size:13.5px}
.tools-row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:16px}
.tools-row .btn{min-height:44px;padding:9px 16px;font-size:13.5px}
/* ============ 百宝箱 ============ */
#closet{background:linear-gradient(180deg,var(--cream),#F6F0E7)}
.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px}
.stat-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.stat-card .st-num{font-family:var(--serif);font-size:28px;font-weight:700}
.stat-card .st-num small{font-size:14px;color:var(--ink-soft);font-family:var(--sans);margin-left:2px}
.stat-card .st-label{font-size:12px;letter-spacing:.14em;color:var(--ink-soft);margin-top:2px}
.cat-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.cat-tabs .tab{min-height:44px;padding:10px 16px;border-radius:999px;border:1px solid var(--line);background:#fff;color:var(--ink-soft);font-size:14px;font-weight:500}
.cat-tabs .tab.active{background:linear-gradient(120deg,#C9A876,#B08D57);color:#fff;border-color:transparent}
.item-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px}
.item-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;position:relative;transition:.2s}
.item-card:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.ic-head{display:flex;align-items:center;gap:10px}
.ic-icon{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,#F3E9D8,#F6EDE6);display:flex;align-items:center;justify-content:center;color:var(--gold-deep)}
.ic-icon svg{width:20px;height:20px}
.ic-name{font-family:var(--serif);font-size:16.5px;font-weight:700;line-height:1.3}
.del-btn{position:absolute;top:10px;right:10px;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#C7BCA9;transition:.2s}
.del-btn:hover{background:var(--red-soft);color:var(--red)}
.ic-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px;font-size:13px;color:var(--ink-soft)}
.color-dot{width:12px;height:12px;border-radius:50%;border:1px solid rgba(0,0,0,.12);display:inline-block}
.style-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
.style-tags span{font-size:11.5px;letter-spacing:.06em;background:var(--rose-soft);color:#9A6A57;border-radius:999px;padding:3px 10px;font-weight:500}
.pao-box{margin-top:12px;border-top:1px dashed var(--line);padding-top:10px}
.pao-bar{height:6px;border-radius:999px;background:#F0E9DC;overflow:hidden}
.pao-bar i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#B08D57,#D6BC8E)}
.pao-txt{font-size:12.5px;margin-top:6px;display:flex;justify-content:space-between}
.pao-ok{color:var(--green)} .pao-soon{color:var(--amber)} .pao-exp{color:var(--red);font-weight:700}
.worn-box{margin-top:12px;border-top:1px dashed var(--line);padding-top:10px;font-size:13px;color:var(--ink-soft);display:flex;justify-content:space-between}
.worn-box b{color:var(--gold-deep)}
.empty-tip{grid-column:1/-1;text-align:center;padding:44px 20px;color:var(--ink-soft);border:1.5px dashed var(--line);border-radius:14px;background:rgba(255,255,255,.6)}
/* 添加表单 */
.add-panel{margin-top:22px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.add-panel-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;padding:18px 22px;font-size:16px;font-weight:600;color:var(--ink)}
.add-panel-body{display:none;padding:0 22px 22px;border-top:1px dashed var(--line)}
.add-panel.open .add-panel-body{display:block}
.add-panel.open .add-panel-toggle .arrow{transform:rotate(45deg)}
.arrow{transition:.25s;color:var(--gold);font-size:22px;font-weight:300}
.fgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}
.fgrid .full{grid-column:1/-1}
.fitem label{display:block;font-size:13px;color:var(--ink-soft);margin-bottom:6px;font-weight:500}
.fitem input,.fitem select{width:100%;min-height:44px;border:1px solid var(--line);border-radius:11px;padding:8px 12px;background:#FDFAF5;outline:none}
.fitem input:focus,.fitem select:focus{border-color:var(--gold-light);box-shadow:0 0 0 3px rgba(214,188,142,.25)}
.style-checks{display:flex;gap:8px;flex-wrap:wrap}
.style-checks label{display:flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:8px 14px;font-size:13.5px;cursor:pointer;color:var(--ink-soft);margin:0;transition:.15s}
.style-checks input{accent-color:var(--gold);width:16px;height:16px}
.style-checks label:has(input:checked){background:var(--ink);color:#F5EFE6;border-color:var(--ink)}
.form-actions{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}
/* ============ 潮流雷达（深色区） ============ */
#radar{background:var(--night);color:#EDE6DA;position:relative;overflow:hidden}
#radar::before{content:"";position:absolute;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(176,141,87,.16),transparent 65%);top:-200px;right:-140px}
#radar .sec-sub{color:#B3A48E}
#radar .sec-num{color:var(--gold-light)}
.trend-row{display:flex;gap:14px;overflow-x:auto;padding:4px 4px 18px;scroll-snap-type:x mandatory}
.trend-row::-webkit-scrollbar{height:6px}
.trend-row::-webkit-scrollbar-thumb{background:#3A322A;border-radius:99px}
.trend-card{scroll-snap-align:start;min-width:250px;background:var(--night-2);border:1px solid #33291F;border-radius:16px;padding:20px;transition:.2s;cursor:pointer}
.trend-card:hover{border-color:var(--gold)}
.trend-card.sel{border-color:var(--gold-light);background:linear-gradient(160deg,#2A221A,#221C17);box-shadow:0 0 0 1px var(--gold-light),0 14px 34px rgba(0,0,0,.4)}
.tc-en{font-size:11px;letter-spacing:.26em;color:var(--gold-light);font-weight:700;text-transform:uppercase}
.tc-name{font-family:var(--serif);font-size:23px;font-weight:700;margin:8px 0 10px;color:#F5EDE0}
.tc-kw{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.tc-kw span{font-size:12px;border:1px solid #3E342A;border-radius:999px;padding:3px 10px;color:#C9BB9F}
.heat-row{display:flex;align-items:center;gap:10px;font-size:12px;color:#B3A48E}
.heat-bar{flex:1;height:5px;background:#332B22;border-radius:99px;overflow:hidden}
.heat-bar i{display:block;height:100%;background:linear-gradient(90deg,#B08D57,#D9A38F)}
.fit-badge{margin-top:12px;font-size:12.5px;color:var(--gold-light);display:flex;justify-content:space-between;align-items:center}
.fit-badge b{font-family:var(--serif);font-size:19px}
/* AI Match */
.match-head{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap;margin:34px 0 18px}
.match-head h3{font-family:var(--serif);font-size:26px}
.match-head p{color:#B3A48E;font-size:13.5px;margin-top:4px}
.look-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.look-card{background:#FBF8F4;color:var(--ink);border-radius:16px;padding:20px;position:relative;overflow:hidden}
.look-card::after{content:"";position:absolute;top:0;left:0;width:44px;height:44px;background:linear-gradient(135deg,rgba(201,168,118,.28),transparent);border-radius:0 0 14px 0}
.lk-no{font-family:var(--serif);font-size:13px;color:var(--gold);letter-spacing:.2em}
.lk-title{font-family:var(--serif);font-size:20px;font-weight:700;margin:6px 0 4px}
.lk-desc{font-size:13px;color:var(--ink-soft);margin-bottom:12px}
.lk-list{list-style:none;display:flex;flex-direction:column;gap:7px}
.lk-list li{display:flex;justify-content:space-between;gap:8px;font-size:13.5px;border-bottom:1px dashed var(--line);padding-bottom:7px}
.lk-list li span:first-child{color:var(--ink-soft)}
.lk-list li span:last-child{font-weight:600;text-align:right}
.lk-foot{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-size:13px}
.lk-foot .lk-cpw{color:var(--gold-deep);font-weight:600}
.lk-free{font-size:11.5px;letter-spacing:.14em;color:#fff;background:linear-gradient(120deg,#B08D57,#96784A);border-radius:999px;padding:4px 10px;font-weight:600}
.lk-fresh{display:inline-block;margin-top:9px;font-size:12px;color:#9A6A57;background:var(--rose-soft);border-radius:999px;padding:3px 11px}
/* Persona & 断舍离 */
.duo-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:34px}
.persona-card{border-radius:var(--radius);padding:28px;background:linear-gradient(150deg,#2A2118 0%,#1B1611 55%,#241B14 100%);border:1px solid #463826;position:relative;overflow:hidden}
.persona-card::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 85% 15%,rgba(217,163,143,.22),transparent 55%),radial-gradient(circle at 10% 90%,rgba(176,141,87,.18),transparent 50%)}
.pc-inner{position:relative}
.pc-label{font-size:11px;letter-spacing:.3em;color:var(--gold-light);font-weight:700;text-transform:uppercase}
.pc-main{font-family:var(--serif);font-size:clamp(24px,3vw,32px);font-weight:700;color:#F5EDE0;margin:14px 0 4px;line-height:1.35}
.pc-quote{font-size:13.5px;color:#C9BB9F;margin-top:12px;border-left:2px solid var(--gold);padding-left:12px}
.pc-bars{margin:18px 0 6px;display:flex;flex-direction:column;gap:9px}
.pc-bar-row{display:grid;grid-template-columns:110px 1fr 44px;gap:10px;align-items:center;font-size:12.5px;color:#C9BB9F}
.pc-bar{height:6px;background:#33291F;border-radius:99px;overflow:hidden}
.pc-bar i{display:block;height:100%;background:linear-gradient(90deg,#C9A876,#D9A38F);border-radius:99px;transition:width .8s ease}
.pc-share{margin-top:14px;font-size:12px;color:#8F8270;letter-spacing:.06em}
.panel-dark{background:var(--night-2);border:1px solid #33291F;border-radius:var(--radius);padding:26px}
.panel-dark h3{font-family:var(--serif);font-size:21px;color:#F5EDE0}
.panel-dark .pd-sub{font-size:13px;color:#B3A48E;margin-top:4px}
.neglect-item{border-top:1px dashed #3A3026;padding:14px 0;margin-top:12px}
.neglect-item:first-of-type{border-top:none}
.ng-name{font-family:var(--serif);font-size:17px;font-weight:700;color:#F0E7D8}
.ng-tag{display:inline-block;font-size:11.5px;background:rgba(192,86,79,.16);color:#E2A29C;border-radius:999px;padding:3px 10px;margin-left:8px;vertical-align:2px}
.ng-tips{margin:10px 0 8px;padding-left:0;list-style:none;display:flex;flex-direction:column;gap:5px}
.ng-tips li{font-size:13px;color:#C9BB9F;display:flex;gap:8px}
.ng-tips li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--gold);margin-top:8px;flex:none}
.ng-sell{font-size:13px;color:#D6BC8E;background:rgba(176,141,87,.1);border:1px solid rgba(176,141,87,.25);border-radius:10px;padding:8px 12px}
/* ============ 折扣情报 ============ */
#deals .sec-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px}
.deal-date{font-size:13px;color:var(--ink-soft);display:flex;align-items:center;gap:8px}
.deal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:14px}
.deal-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;position:relative;display:flex;flex-direction:column;gap:10px}
.deal-brand{display:flex;align-items:center;gap:12px}
.brand-dot{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:18px;font-weight:700;color:#fff;flex:none}
.deal-brand .db-name{font-family:var(--serif);font-size:17px;font-weight:700}
.deal-brand .db-cat{font-size:12px;color:var(--ink-soft)}
.deal-title{font-size:14.5px;font-weight:600}
.deal-note{font-size:13px;color:var(--ink-soft)}
.off-badge{position:absolute;top:16px;right:16px;background:linear-gradient(120deg,#C0564F,#A8433D);color:#fff;font-family:var(--serif);font-weight:700;font-size:15px;border-radius:10px;padding:5px 10px;transform:rotate(3deg);box-shadow:0 4px 12px rgba(192,86,79,.35)}
.hidden-tag{display:inline-flex;align-items:center;gap:5px;align-self:flex-start;font-size:11.5px;letter-spacing:.1em;background:var(--ink);color:var(--gold-light);border-radius:999px;padding:4px 10px;font-weight:600}
.deal-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:auto;border-top:1px dashed var(--line);padding-top:12px}
.deal-dl{font-size:12.5px;color:var(--ink-soft)}
.code-btn{display:inline-flex;align-items:center;gap:7px;border:1.5px dashed var(--gold);color:var(--gold-deep);border-radius:10px;padding:8px 13px;font-size:13.5px;font-weight:700;min-height:44px;letter-spacing:.08em;background:#FDFAF3}
.code-btn:active{transform:scale(.96)}
.deals-more{display:flex;justify-content:center;margin-top:20px}
.deals-more .btn{background:#fff;border:1px solid var(--line);color:var(--ink-soft)}
/* ============ 省钱账本 ============ */
#savings{background:linear-gradient(180deg,#F6F0E7,var(--cream))}
.save-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:16px;align-items:stretch}
.save-hero{background:linear-gradient(150deg,#241D15,#171310 65%);border-radius:var(--radius);padding:30px;color:#EDE6DA;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;min-height:280px}
.save-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(217,163,143,.2),transparent 55%)}
.sh-inner{position:relative}
.sh-label{font-size:11px;letter-spacing:.3em;color:var(--gold-light);font-weight:700;text-transform:uppercase}
.sh-num{font-family:var(--serif);font-size:clamp(42px,5vw,60px);font-weight:700;line-height:1.1;margin:10px 0 4px;color:#F7EFDF}
.sh-sub{font-size:13.5px;color:#B3A48E}
.sh-stats{display:flex;gap:26px;position:relative;flex-wrap:wrap}
.sh-stat .n{font-family:var(--serif);font-size:24px;font-weight:700;color:#F0E7D8}
.sh-stat .l{font-size:12px;color:#B3A48E;letter-spacing:.1em}
.save-form{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:22px}
.save-form h4{font-family:var(--serif);font-size:19px;margin-bottom:4px}
.save-form .sf-sub{font-size:13px;color:var(--ink-soft);margin-bottom:16px}
.sf-row{display:grid;grid-template-columns:1fr 130px 110px;gap:10px}
.sf-row input,.sf-row select{width:100%;min-height:44px;border:1px solid var(--line);border-radius:11px;padding:8px 12px;background:#FDFAF5;outline:none}
.sf-row input:focus,.sf-row select:focus{border-color:var(--gold-light);box-shadow:0 0 0 3px rgba(214,188,142,.25)}
.savings-list{margin-top:18px;display:flex;flex-direction:column;gap:8px;max-height:230px;overflow:auto}
.savings-list .row{display:flex;justify-content:space-between;align-items:center;gap:10px;border:1px solid #F0E9DC;background:#FDFAF5;border-radius:11px;padding:10px 14px;font-size:14px}
.savings-list .row .r-date{color:#A79A85;font-size:12px;flex:none}
.amt-saved{color:var(--green);font-weight:700;flex:none}
.amt-earned{color:var(--gold-deep);font-weight:700;flex:none}
.chart-block{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:22px;margin-top:16px}
.chart-block h4{font-family:var(--serif);font-size:19px}
.chart-block .cb-sub{font-size:13px;color:var(--ink-soft);margin:2px 0 14px}
/* CPW */
.cpw-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
.cpw-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px}
.cpw-card h4{font-family:var(--serif);font-size:19px;margin-bottom:4px}
.cpw-card .cb-sub{font-size:13px;color:var(--ink-soft);margin-bottom:14px}
.cpw-card select{width:100%;min-height:44px;border:1px solid var(--line);border-radius:11px;padding:8px 12px;background:#FDFAF5}
.cpw-ring{display:flex;align-items:center;gap:20px;margin-top:16px}
.cpw-ring-txt .n{font-family:var(--serif);font-size:30px;font-weight:700;color:var(--gold-deep)}
.cpw-ring-txt .d{font-size:13px;color:var(--ink-soft)}
.cpw-verdict{margin-top:12px;font-size:13.5px;border-radius:10px;padding:9px 13px}
/* 成就徽章 */
.badge-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:14px}
.badge{border:1px solid var(--line);border-radius:12px;padding:14px 12px;text-align:center;background:#FDFAF5;opacity:.45;transition:.25s}
.badge.got{opacity:1;background:linear-gradient(160deg,#FFFDF8,#F6EDDD);border-color:var(--gold-light);box-shadow:0 6px 16px rgba(176,141,87,.14)}
.badge .b-icon{width:34px;height:34px;margin:0 auto 8px;border-radius:50%;background:#EFE6D6;display:flex;align-items:center;justify-content:center;color:var(--gold-deep)}
.badge.got .b-icon{background:linear-gradient(135deg,#C9A876,#96784A);color:#fff}
.badge .b-name{font-size:13.5px;font-weight:700}
.badge .b-desc{font-size:11.5px;color:var(--ink-soft);margin-top:2px}
/* ============ 页脚 ============ */
footer{background:var(--night);color:#B3A48E;padding:44px 0 36px}
.f-grid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:flex-start}
.f-brand b{font-family:var(--serif);font-size:22px;color:#F0E7D8;letter-spacing:.12em;display:block}
.f-brand span{font-size:11px;letter-spacing:.3em;color:var(--gold-light)}
.f-note{font-size:12.5px;max-width:420px;margin-top:10px;line-height:1.7}
.f-tools{display:flex;gap:10px;flex-wrap:wrap}
.f-tools .btn{min-height:40px;padding:7px 16px;font-size:13px;background:transparent;border:1px solid #3A3026;color:#C9BB9F}
.f-tools .btn:hover{border-color:var(--gold);color:var(--gold-light)}
.f-bottom{border-top:1px solid #2B241C;margin-top:26px;padding-top:18px;font-size:12px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
/* ============ 模态 & Toast ============ */
#modalMask{position:fixed;inset:0;background:rgba(23,19,16,.5);backdrop-filter:blur(4px);z-index:200;display:none;align-items:center;justify-content:center;padding:20px}
#modalMask.open{display:flex}
.modal{background:#fff;border-radius:18px;padding:28px;max-width:380px;width:100%;box-shadow:0 24px 70px rgba(0,0,0,.3);animation:pop .22s ease}
@keyframes pop{from{transform:scale(.94);opacity:0}to{transform:scale(1);opacity:1}}
.modal h3{font-family:var(--serif);font-size:20px;margin-bottom:8px}
.modal p{font-size:14px;color:var(--ink-soft)}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px}
#toast{position:fixed;left:50%;bottom:calc(28px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(16px);background:var(--ink);color:#F5EFE6;padding:11px 22px;border-radius:999px;font-size:14px;z-index:300;opacity:0;pointer-events:none;transition:.28s;box-shadow:0 10px 30px rgba(0,0,0,.25);max-width:88vw;text-align:center}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
/* ============ 响应式 ============ */
@media(max-width:900px){
  .stat-strip{grid-template-columns:repeat(2,1fr)}
  .look-grid,.duo-grid,.save-grid,.cpw-grid{grid-template-columns:1fr}
  #hero .wrap{grid-template-columns:1fr}
  .hero-stage{height:400px;max-width:400px;margin:0 auto;width:100%}
  .float-card{position:absolute;width:170px;padding:12px 14px}
  .float-card .fc-main{font-size:17px}
  .fc1{top:0;right:6px;transform:rotate(2deg)}
  .fc2{top:126px;left:0;transform:rotate(-2.5deg)}
  .fc3{bottom:0;right:6px;transform:rotate(1.5deg)}
  .fc2 .fc-main{font-size:18px}
  .fc3 .fc-main{font-size:14.5px}
}
@media(max-width:768px){
  section{padding:48px 0}
  .nav-links{display:none}
  #burger{display:flex}
  #hero{padding-top:36px}
  .today-cards{grid-template-columns:1fr}
  .fgrid{grid-template-columns:1fr}
  .sf-row{grid-template-columns:1fr}
  .item-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
  .ic-name{font-size:15px}
  .float-card{width:180px;padding:12px 14px}
  .fc2{left:0}
  .vert-text{display:none}
  .weather .w-num{font-size:32px}
  .deal-grid{grid-template-columns:1fr}
  .badge-grid{grid-template-columns:repeat(2,1fr)}
  .cpw-ring svg{width:110px;height:110px}
  .lk-list li{font-size:13px}
}
</style>
</head>
<body>

<!-- Toast / 模态 -->
<div id="toast"></div>
<div id="modalMask">
  <div class="modal">
    <h3 id="modalTitle"></h3>
    <p id="modalMsg"></p>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="modalCancel">取消</button>
      <button class="btn btn-ink" id="modalOk">确认</button>
    </div>
  </div>
</div>

<!-- 顶部导航 -->
<header id="topbar">
  <div class="wrap">
    <a class="logo" href="#hero"><b>STYLE HUB</b><span>风格衣橱</span></a>
    <nav class="nav-links">
      <a href="#daily">今日风格</a>
      <a href="#closet">数字百宝箱</a>
      <a href="#radar">潮流 Match</a>
      <a href="#deals">折扣情报</a>
      <a href="#savings">省钱账本</a>
    </nav>
    <button id="burger" aria-label="菜单">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav id="mobileNav">
    <a href="#daily">今日风格</a>
    <a href="#closet">数字百宝箱</a>
    <a href="#radar">潮流 Match</a>
    <a href="#deals">折扣情报</a>
    <a href="#savings">省钱账本</a>
  </nav>
</header>

<!-- Hero -->
<section id="hero">
  <div class="hero-bg"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div><div class="blob b4"></div><div class="hero-lines"></div></div>
  <div class="wrap">
    <div class="hero-copy">
      <div class="eyebrow">My Beauty &amp; Fashion AI</div>
      <h1>不买新衣，<br>也能穿出<em>下一季</em>的流行</h1>
      <p>STYLE HUB 是懂穿搭、更懂你衣橱的 AI 造型师——把你已有的单品配上最新趋势，从每日 OOTD 到折扣情报、省钱成就，精致生活一步到位。</p>
      <div class="hero-cta">
        <button class="btn btn-gold" data-scroll="radar">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 3v4M3 5h4M6 17v4M4 19h4M13 3l2.5 6.5L22 12l-6.5 2.5L13 21l-2.5-6.5L4 12l6.5-2.5L13 3z"/></svg>
          AI 一键 Match 我的衣橱
        </button>
        <button class="btn btn-ghost" data-scroll="closet">开始整理百宝箱</button>
      </div>
      <div class="hero-tags">
        <span>Clean Girl</span><span>日韩系</span><span>欧美复古</span><span>Y2K</span><span>职场轻熟</span><span>法式轻复古</span>
      </div>
    </div>
    <div class="hero-stage" id="heroStage"></div>
  </div>
</section>

<!-- 跑马灯 -->
<div class="ticker"><div class="ticker-inner" id="tickerInner"></div></div>

<main>
<!-- ============ 今日风格卡 ============ -->
<section id="daily">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="sec-num">DAILY STYLE CARD</div>
        <h2 class="sec-title">今日风格卡</h2>
        <p class="sec-sub">结合今天的天气与场合，AI 从你的百宝箱里抽出「彩妆 + 穿搭 + 发型」三合一套卡。</p>
      </div>
    </div>

    <div id="todayAlerts"></div>

    <div class="today-shell">
      <div class="today-top">
        <div class="weather">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.5" stroke-linecap="round"><circle cx="9" cy="9" r="3.4"/><path d="M9 2.4v1.6M9 14v1.6M2.4 9H4M14 9h1.6M4.2 4.2l1.1 1.1M12.7 12.7l1.1 1.1M13.8 4.2l-1.1 1.1M5.3 12.7l-1.1 1.1"/><path d="M17 20.5a3 3 0 1 0 0-6 4.2 4.2 0 0 0-8.2 1A2.7 2.7 0 0 0 9 20.5h8z" fill="#F3E9D8" stroke="#B08D57"/></svg>
          <div>
            <div class="w-num">30°<small style="font-size:15px;color:var(--ink-soft)">C</small></div>
            <div class="w-meta">多云 · 湿度 78% · 微风</div>
          </div>
          <div style="align-self:center">
            <div class="w-city">HONG KONG</div>
            <div class="w-meta" id="todayDate"></div>
          </div>
        </div>
        <div class="pills" id="occasionPills">
          <button class="pill active" data-occ="work">上班通勤</button>
          <button class="pill" data-occ="date">约会晚餐</button>
          <button class="pill" data-occ="cafe">Cafe 打卡</button>
        </div>
      </div>
      <div class="today-cards" id="dailyCards"></div>
      <div class="today-foot">
        <span class="tf-note">穿搭方案由 AI 根据场合风格偏好，从你的百宝箱即时生成。</span>
        <button class="btn btn-ink" id="shuffleLook">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M16 3h5v5M21 3l-7.5 7.5M8 21H3v-5M3 21l7.5-7.5M21 16v5h-5M14.5 14.5L21 21M3 8V3h5M9.5 9.5L3 3"/></svg>
          换一套
        </button>
      </div>
    </div>

    <div class="tools-row">
      <button class="btn btn-ghost" id="btnExport">
        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
        导出 JSON 备份
      </button>
      <button class="btn btn-ghost" id="btnImport">
        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 15V3m0 0L8 7m4-4l4 4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
        导入恢复
      </button>
      <input type="file" id="fileInput" accept="application/json" hidden>
    </div>
  </div>
</section>

<!-- ============ 01 数字百宝箱 ============ -->
<section id="closet">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-num">01 — MY BEAUTY &amp; FASHION CLOSET</div>
      <h2 class="sec-title">数字时尚百宝箱</h2>
      <p class="sec-sub">把化妆品、护肤品、衣物、鞋包与饰品收进一个页面——自动分类、PAO 保质期倒数、穿搭次数与 CPW 全都看得见。</p>
    </div>

    <div class="stat-strip" id="closetStats"></div>

    <div class="cat-tabs" id="catTabs"></div>
    <div class="item-grid" id="itemGrid"></div>

    <div class="add-panel" id="addPanel">
      <button class="add-panel-toggle" id="addToggle">
        <span style="display:flex;align-items:center;gap:10px">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.7" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          添加一件单品到百宝箱
        </span>
        <span class="arrow">+</span>
      </button>
      <div class="add-panel-body">
        <div class="fgrid">
          <div class="fitem"><label>单品名称 *</label><input id="fName" placeholder="例：丝滑柔雾唇釉 #裸玫瑰" maxlength="30"></div>
          <div class="fitem"><label>分类 *</label>
            <select id="fCat">
              <option value="makeup">彩妆</option><option value="skincare">护肤</option>
              <option value="clothing">衣物</option><option value="shoesbags">鞋包</option><option value="accessory">饰品</option>
            </select>
          </div>
          <div class="fitem"><label>衣物类型（衣物/鞋包时选）</label>
            <select id="fSub">
              <option value="">不指定</option><option value="top">上衣</option><option value="bottom">下装</option>
              <option value="dress">连衣裙</option><option value="outer">外套</option><option value="shoes">鞋履</option><option value="bag">包袋</option>
            </select>
          </div>
          <div class="fitem"><label>颜色</label><input id="fColor" placeholder="例：裸玫瑰" maxlength="10"></div>
          <div class="fitem"><label>价格（¥）</label><input id="fPrice" type="number" min="0" step="1" placeholder="189"></div>
          <div class="fitem"><label>已穿搭次数</label><input id="fWorn" type="number" min="0" step="1" placeholder="0"></div>
          <div class="fitem"><label>开封日期（护肤/彩妆）</label><input id="fOpened" type="date"></div>
          <div class="fitem"><label>PAO 保质期（开封后月数）</label>
            <select id="fPao"><option value="">不适用</option><option value="6">6M</option><option value="12">12M</option><option value="18">18M</option><option value="24">24M</option></select>
          </div>
          <div class="fitem full"><label>风格标签（可多选）</label>
            <div class="style-checks" id="fStyles"></div>
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-gold" id="fSubmit">收进百宝箱</button>
          <button class="btn btn-ghost" id="fReset">清空表单</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 02 潮流雷达 & AI Match（深色） ============ -->
<section id="radar">
  <div class="wrap">
