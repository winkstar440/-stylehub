    var s = rnd()*10;
    (it.styles||[]).forEach(function(st){ var p = prefs.indexOf(st); if(p>-1) s += (prefs.length-p)*8; });
    return {it:it, s:s};
  }).sort(function(a,b){ return b.s-a.s; });
  return scored[0].it;
}
function buildDailyLook(){
  var occ = state.ui.occ, rnd = mulberry32(state.ui.lookSeed*97 + 13);
  var prefs = OCC_PREF[occ];
  var it = state.items;
  function by(fn){ return it.filter(fn); }
  var dress = pickWeighted(by(function(x){return x.subType==='dress';}), prefs, rnd);
  var useDress = dress && rnd()<0.35;
  var top = useDress ? null : pickWeighted(by(function(x){return x.subType==='top';}), prefs, rnd);
  var bottom = useDress ? null : pickWeighted(by(function(x){return x.subType==='bottom';}), prefs, rnd);
  var outer = occ==='work' ? pickWeighted(by(function(x){return x.subType==='outer';}), prefs, rnd) : (rnd()<0.4 ? pickWeighted(by(function(x){return x.subType==='outer';}), prefs, rnd) : null);
  var shoes = pickWeighted(by(function(x){return x.subType==='shoes';}), prefs, rnd);
  var bag = pickWeighted(by(function(x){return x.subType==='bag';}), prefs, rnd);
  var acc = pickWeighted(by(function(x){return x.cat==='accessory';}), prefs, rnd);
  var mk = pickWeighted(by(function(x){return x.cat==='makeup';}), prefs, rnd);
  var hairs = HAIRS[occ]; var hair = hairs[Math.floor(rnd()*hairs.length)] || hairs[0];
  var lip = mk ? mk.name.split(' #')[0] : '你衣橱里的唇釉';
  return {
    pieces: useDress ? [dress, shoes, bag, acc].filter(Boolean) : [top, bottom, outer, shoes, bag, acc].filter(Boolean),
    dress: !!useDress, hair: hair,
    makeupNote: MAKEUP_NOTES[occ].replace('{lip}', lip),
    makeupItem: mk, missing: (!top && !dress) ? '上衣或连衣裙' : (!useDress && !bottom ? '下装' : (!shoes ? '鞋履' : null))
  };
}
function buildTrendLooks(trendName){
  var prefs = [trendName];
  var pool = state.items.filter(function(i){ return (i.styles||[]).indexOf(trendName)>-1; });
  var fallback = state.items;
  var looks = [], usedGlobal = {};
  /* 每套 Look 的策略：0 优先未穿过、1 优先高 CPW 闲置、2 优先高频百搭 */
  var strategy = [
    { avoid:true,  tag:'日常版' },
    { avoid:false, tag:'进阶版' },
    { avoid:false, tag:'心机版' }
  ];
  for(var k=0;k<3;k++){
    var usedLocal = {};
    function pick(fn, seedAdd){
      var list = (pool.length ? pool : fallback).filter(fn);
      if(!list.length) list = fallback.filter(fn);
      if(!list.length) return null;
      /* 优先挑本轮没用过的，避免同套内重复 */
      var fresh = list.filter(function(x){ return !usedLocal[x.id]; });
      if(fresh.length) list = fresh;
      var r = mulberry32(state.ui.matchSeed*131 + k*211 + seedAdd*17 + 7);
      var scored = list.map(function(it){
        var s = r()*6;
        (it.styles||[]).forEach(function(st){ var p = prefs.indexOf(st); if(p>-1) s += 14; });
        /* 策略 0：优先从未穿过 / 低频，制造「旧衣新穿」惊喜 */
        if(strategy[k].avoid){
          if((it.worn||0)===0) s += 18;
          else s -= Math.min(12, (it.worn||0)*0.8);
        } else {
          s += Math.min(8, (it.worn||0)*0.4);
        }
        /* 偏好本套尚未使用的单品与全局未使用单品 */
        if(usedLocal[it.id]) s -= 40;
        if(k>0 && usedGlobal[it.id]) s -= 10;
        return { it:it, s:s };
      }).sort(function(a,b){ return b.s - a.s; });
      var chosen = scored[0].it;
      usedLocal[chosen.id] = true;
      usedGlobal[chosen.id] = true;
      return chosen;
    }
    var r2 = mulberry32(state.ui.matchSeed*131 + k*53 + 7);
    var dress = pick(function(x){return x.subType==='dress';}, 1);
    var useDress = dress && r2()<0.32;
    var top = useDress?null:pick(function(x){return x.subType==='top';}, 2);
    var bottom = useDress?null:pick(function(x){return x.subType==='bottom';}, 3);
    var outer = r2()<0.55 ? pick(function(x){return x.subType==='outer';}, 4) : null;
    var shoes = pick(function(x){return x.subType==='shoes';}, 5);
    var bag = pick(function(x){return x.subType==='bag';}, 6);
    var acc = pick(function(x){return x.cat==='accessory';}, 7);
    var pieces = (useDress ? [dress,shoes,bag,acc] : [top,bottom,outer,shoes,bag,acc]).filter(Boolean);
    /* 去掉同一套里的重复单品 */
    var seen = {}, uniq = [];
    pieces.forEach(function(p){ if(!seen[p.id]){ seen[p.id]=1; uniq.push(p); } });
    if(!uniq.length) continue;
    var cpwSum = 0, wornSum = 0;
    uniq.forEach(function(p){ cpwSum += cpwOf(p); wornSum += (p.worn||0); });
    looks.push({ pieces:uniq, dress:!!useDress, cpw: uniq.length? cpwSum/uniq.length : 0, wornSum:wornSum, tag:strategy[k].tag });
  }
  return looks;
}
