/* ================= 计算层 ================= */
function paoInfo(it){
  if((it.cat!=='skincare' && it.cat!=='makeup') || !it.openedAt || !it.paoMonths) return null;
  var opened = new Date(it.openedAt+'T00:00:00');
  if(isNaN(opened)) return null;
  var exp = new Date(opened.getTime()); exp.setMonth(exp.getMonth() + it.paoMonths);
  var today = new Date(); today.setHours(0,0,0,0);
  var days = Math.round((exp - today)/86400000);
  return { days:days, pct:Math.max(4, Math.min(100, Math.round(days/(it.paoMonths*30.4)*100))), status: days<0?'expired':(days<=30?'soon':'ok') };
}
function cpwOf(it){ var w = Math.max(1, it.worn||0); return (it.price||0)/w; }
function personaList(){
  var cnt = {}; var total = 0;
  state.items.forEach(function(i){ (i.styles||[]).forEach(function(s){ cnt[s]=(cnt[s]||0)+1; total++; }); });
  if(!total) return [];
  var arr = Object.keys(cnt).map(function(k){ return {style:k, n:cnt[k], pct:Math.round(cnt[k]/total*100)}; }).sort(function(a,b){ return b.n-a.n; });
  var rest = arr.slice(1).reduce(function(s,x){ return s+x.pct; },0);
  arr[0].pct = Math.max(1, 100-rest);
  return arr.slice(0,4);
}
