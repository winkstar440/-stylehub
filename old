    '<div class="pc-main">'+main.pct+'% '+esc(main.style)+(list[1]?' × '+list[1].pct+'% '+esc(list[1].style):'')+'</div>'+
    '<p class="pc-quote">'+(quotes[main.style]||'你的风格，由你的衣橱说了算。')+'</p>'+
    '<div class="pc-bars">'+bars+'</div>'+
    '<p class="pc-share">长按或截图这张卡片，分享到小红书 / IG，晒出你的风格密码。</p>';
  setTimeout(function(){
    var els = document.querySelectorAll('.pc-bar i');
    for(var i=0;i<els.length;i++){ els[i].style.width = els[i].getAttribute('data-w')+'%'; }
  }, 60);
}
function renderNeglect(){
  var list = neglectItems();
  if(!list.length){
    $('neglectBody').innerHTML = '<p style="margin-top:14px;font-size:13.5px;color:#B3A48E">很棒——目前没有闲置超过半年的单品，衣橱利用率满分。等有新闲置，AI 会出现在这里。</p>';
    return;
  }
  var tipPool = {
    top:['内搭在吊带裙里，加一条金属项链，Y2K 层次感立刻回来','外披在衬衫外面当针织披肩，法式慵懒不打折','下摆塞进高腰裤 + 细腰带，比例立刻上移'],
    bottom:['搭配短款上衣，露出腰线最显高','换成同色系上衣做一套式穿搭，视觉拉长','周末搭配波鞋，把正式感降下来'],
    dress:['白天外搭 T 恤做两层穿法，一裙两穿','晚上单穿 + 金属饰品，直接赴约','天凉叠穿高领打底，又能多穿一季'],
    default:['与现有单品换个组合，说不定就是新风格','换一种穿法（塞、叠、披），旧衣秒变新款','搭配配饰重造焦点，成本为零']
  };
  $('neglectBody').innerHTML = list.map(function(i){
    var tips = (tipPool[i.subType] || tipPool.default).map(function(t){ return '<li>'+t+'</li>'; }).join('');
    var sell = Math.round((i.price||0)*0.45);
    return '<div class="neglect-item"><div class="ng-name">'+esc(i.name)+'<span class="ng-tag">'+((i.worn||0)===0?'从未穿搭':'很少穿搭')+'</span></div>'+
      '<ul class="ng-tips">'+tips+'</ul>'+
      '<div class="ng-sell">都不心动？建议二手转卖参考价 ¥'+sell+'（约原价 45 折），或参加品牌旧衣回收换购物券。</div></div>';
  }).join('');
}
function dealCardsHTML(limit){
  return DEMO_DEALS.slice(0, limit).map(function(dl){
    var codeHtml = dl.code
      ? '<button class="code-btn" data-code="'+esc(dl.code)+'"><svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>'+esc(dl.code)+'</button>'
      : '<span class="deal-dl" style="letter-spacing:.06em">到店 / 官网直接享受</span>';
    return '<div class="deal-card">'+
      (dl.hidden?'<span class="hidden-tag"><svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.6"/></svg>隐藏优惠</span>':'')+
      '<div class="deal-brand"><div class="brand-dot" style="background:'+dl.color+'">'+dl.initial+'</div><div><div class="db-name">'+esc(dl.brand)+'</div><div class="db-cat">'+esc(dl.cat)+'</div></div></div>'+
      '<div class="deal-title">'+esc(dl.title)+'</div><div class="deal-note">'+esc(dl.note)+'</div>'+
      '<div class="deal-foot"><span class="deal-dl">'+esc(dl.dl)+'</span>'+codeHtml+'</div></div>';
  }).join('');
}
function renderDeals(){
  var d = new Date();
  $('dealDate').innerHTML = '<svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="4" y="5" width="16" height="16" rx="2.5"/><path d="M8 3v4m8-4v4M4 10h16"/></svg> '+(d.getMonth()+1)+' 月 '+d.getDate()+' 日更新 · 已核实全部链接';
  $('dealGrid').innerHTML = dealCardsHTML(6);
}
function renderSavings(){
  var saved = 0, earned = 0, cnt = 0;
  state.savings.forEach(function(s){
    if(s.type==='earned') earned += (s.amount||0); else { saved += (s.amount||0); cnt++; }
  });
  $('saveTotal').textContent = money(saved);
  $('saveCount').textContent = cnt;
  $('earnTotal').textContent = money(earned);
  var best = null;
  state.items.forEach(function(i){ if(i.cat==='clothing'||i.cat==='shoesbags'){ if(!best || cpwOf(i)<cpwOf(best)) best = i; } });
  $('cpwBest').textContent = best ? money(cpwOf(best)) : '—';
  $('saveSub').textContent = cnt ? '比冲动消费的你，多出 '+money(saved)+' 的置装预算——这些钱可以留给真正心动的单品。' : '还没有记录，写下第一条忍手战绩吧';
  $('savingsList').innerHTML = state.savings.length ? state.savings.slice().reverse().map(function(s){
    return '<div class="row"><span>'+esc(s.name)+' <span class="r-date">'+esc(s.date)+'</span></span><span class="'+(s.type==='earned'?'amt-earned':'amt-saved')+'">'+(s.type==='earned'?'+':'省 ')+money(s.amount)+'</span></div>';
  }).join('') : '<div class="row" style="justify-content:center;color:var(--ink-soft)">暂无记录</div>';
  /* 近 7 天柱状图（内联 SVG） */
  var data = savings7d(), max = 1;
  data.forEach(function(x){ if(x.sum>max) max = x.sum; });
  var W = 700, H = 190, bw = 44, gap = (W - 56 - bw*7) / 6;
  var baseY = H - 30, plotH = H - 78;
  var bars = '';
  data.forEach(function(x,i){
    var h = x.sum>0 ? Math.max(14, x.sum/max*plotH) : 4;
    var cx = 28 + i*(bw+gap);
    bars += '<rect x="'+cx+'" y="'+(baseY-h)+'" width="'+bw+'" height="'+h+'" rx="7" fill="'+(x.sum>0?'url(#gld)':'#EFE8DA')+'"/>';
    if(x.sum>0) bars += '<text x="'+(cx+bw/2)+'" y="'+(baseY-h-9)+'" text-anchor="middle" font-size="12.5" fill="#96784A" font-weight="700">¥'+x.sum+'</text>';
    bars += '<text x="'+(cx+bw/2)+'" y="'+(H-10)+'" text-anchor="middle" font-size="11.5" fill="#A79A85">'+x.label+'</text>';
  });
  $('chart7').innerHTML = '<svg viewBox="0 0 700 190" style="width:100%;height:auto" role="img" aria-label="近7天省钱金额柱状图"><defs><linearGradient id="gld" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#C9A876"/><stop offset="1" stop-color="#B08D57"/></linearGradient></defs>'+bars+'</svg>';
  /* CPW 选择 */
  var wearables = state.items.filter(function(i){ return i.cat==='clothing'||i.cat==='shoesbags'||i.cat==='accessory'; });
  $('cpwSelect').innerHTML = '<option value="">— 选择单品 —</option>' + wearables.map(function(i){ return '<option value="'+esc(i.id)+'"'+(state.ui.cpwId===i.id?' selected':'')+'>'+esc(i.name)+'</option>'; }).join('');
  var sel = wearables.filter(function(i){ return i.id===state.ui.cpwId; })[0];
  if(sel){
    var c = cpwOf(sel), ratio = Math.min(1, Math.max(0.05, 1 - c/300));
    var vtxt, vcls;
    if(c<=30){ vtxt='神级性价比！这件已经快穿回本了，是衣橱劳模。'; vcls='background:var(--green-soft);color:var(--green)'; }
    else if(c<=80){ vtxt='很会买！按这个穿着频率，它完全对得起价格。'; vcls='background:var(--amber-soft);color:var(--amber)'; }
    else { vtxt='成本还有点高——多穿几次，或者考虑二手转卖回血。'; vcls='background:var(--red-soft);color:var(--red)'; }
    var circ = 2*Math.PI*44, off = circ*(1-ratio);
    $('cpwResult').innerHTML = '<div class="cpw-ring"><svg width="120" height="120" viewBox="0 0 120 120"><circle cx="60" cy="60" r="44" fill="none" stroke="#F0E9DC" stroke-width="10"/><circle cx="60" cy="60" r="44" fill="none" stroke="url(#gld2)" stroke-width="10" stroke-linecap="round" stroke-dasharray="'+circ+'" stroke-dashoffset="'+off+'" transform="rotate(-90 60 60)"/><defs><linearGradient id="gld2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#C9A876"/><stop offset="1" stop-color="#D9A38F"/></linearGradient></defs></svg><div class="cpw-ring-txt"><div class="n">'+money(c)+'</div><div class="d">每穿一次的成本<br>已穿搭 '+esc(String(sel.worn||0))+' 次 · 原价 '+money(sel.price||0)+'</div></div></div><div class="cpw-verdict" style="'+vcls+'">'+vtxt+'</div>';
  } else {
    $('cpwResult').innerHTML = '<p style="margin-top:14px;font-size:13.5px;color:var(--ink-soft)">选一件衣物或鞋包，查看它每次穿着帮你摊薄到多少钱。</p>';
  }
  /* 徽章 */
  var badges = [
    { got: saved>=500, name:'初阶忍手族', desc:'累计省下 ¥500+' },
    { got: saved>=1500, name:'省钱艺术家', desc:'累计省下 ¥1500+' },
    { got: cnt>=5, name:'冷静天使', desc:'忍手 5 次以上' },
    { got: best && cpwOf(best)<=30, name:'CPW 之王', desc:'有单品 CPW ≤ ¥30' },
    { got: earned>0, name:'循环时尚人', desc:'完成一次转卖回血' },
    { got: state.items.length>=15, name:'衣橱策展人', desc:'百宝箱收纳 15 件+' }
  ];
  $('badgeGrid').innerHTML = badges.map(function(b){
    return '<div class="badge'+(b.got?' got':'')+'"><div class="b-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.5 5.5L20 9.3l-4 4 1 5.7-5-2.8-5 2.8 1-5.7-4-4 5.5-.8L12 3z"/></svg></div><div class="b-name">'+b.name+'</div><div class="b-desc">'+b.desc+'</div></div>';
  }).join('');
}
function renderStyleChecks(){
  $('fStyles').innerHTML = STYLES.map(function(s){
    return '<label><input type="checkbox" value="'+esc(s)+'">'+esc(s)+'</label>';
  }).join('');
}

/* ================= 统一刷新入口 ================= */
function refreshAll(){
  renderTodayAlerts();
  renderDailyCards();
  renderClosetStats();
  renderCloset();
  renderTrends();
  renderMatch();
  renderPersona();
  renderNeglect();
  renderSavings();
}

/* ================= 事件处理 ================= */
function bindEvents(){
  document.addEventListener('click', function(e){
    var sc = e.target.closest('[data-scroll]');
    if(sc){ var el = $(sc.getAttribute('data-scroll')); if(el){ el.scrollIntoView({behavior:'smooth'}); } $('mobileNav').classList.remove('open'); }
    var pill = e.target.closest('#occasionPills .pill');
    if(pill){ state.ui.occ = pill.getAttribute('data-occ'); state.ui.lookSeed = Math.floor(Math.random()*1e6); saveUI(); refreshAll(); }
    var tab = e.target.closest('#catTabs .tab');
    if(tab){ state.ui.activeCat = tab.getAttribute('data-cat'); saveUI(); refreshAll(); }
    var del = e.target.closest('[data-del]');
    if(del){
      var id = del.getAttribute('data-del');
      state.items = state.items.filter(function(i){ return i.id!==id; });
      if(state.ui.cpwId===id) state.ui.cpwId = '';
      saveItems(); refreshAll(); toast('已从百宝箱移除');
    }
    var tr = e.target.closest('.trend-card');
    if(tr){ state.ui.trendSel = tr.getAttribute('data-trend'); saveUI(); refreshAll(); }
    var cp = e.target.closest('.code-btn');
    if(cp){
      var code = cp.getAttribute('data-code');
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(code).then(function(){ toast('优惠码 '+code+' 已复制，去结账粘贴'); }, function(){ toast('优惠码：'+code); });
      } else { toast('优惠码：'+code); }
    }
    if(e.target.closest('#shuffleLook')){ state.ui.lookSeed = Math.floor(Math.random()*1e6); saveUI(); refreshAll(); toast('已为你换一套 '+OCC_NAME[state.ui.occ]+'造型'); }
    if(e.target.closest('#btnRematch')){ state.ui.matchSeed = Math.floor(Math.random()*1e6); saveUI(); refreshAll(); toast('AI 重新搭配完成，依然 0 元购入'); }
    if(e.target.closest('#tipClose')){ state.ui.tipClosed = true; saveUI(); refreshAll(); }
    if(e.target.closest('#tipGo')){ $('btnExport').click(); }
    if(e.target.closest('#moreDeals')){
      $('dealGrid').innerHTML = dealCardsHTML(DEMO_DEALS.length);
      $('moreDeals').style.display = 'none'; toast('已展示今日全部 '+DEMO_DEALS.length+' 条情报');
    }
    if(e.target.closest('#btnExport') || e.target.closest('#btnExport2')){ exportJSON(); }
    if(e.target.closest('#btnImport') || e.target.closest('#btnImport2')){ $('fileInput').click(); }
    if(e.target.closest('#btnDemoReset')){
      confirmModal('恢复示例数据','将把 16 件示例单品与 3 条省钱示例记录加回（不会删除你已添加的内容）。','恢复', function(){
        DEMO_ITEMS.forEach(function(d){ if(!state.items.some(function(i){ return i.id===d.id; })) state.items.push(JSON.parse(JSON.stringify(d))); });
        DEMO_SAVINGS.forEach(function(d){ if(!state.savings.some(function(i){ return i.id===d.id; })) state.savings.push(JSON.parse(JSON.stringify(d))); });
        saveItems(); saveSavings(); refreshAll(); toast('示例数据已恢复');
      });
    }
    if(e.target.closest('#btnClearAll')){
      confirmModal('清空全部数据','将删除百宝箱全部单品与省钱记录（含你自己添加的），此操作不可撤销。建议先导出备份。','清空', function(){
        state.items = []; state.savings = []; state.ui.cpwId = '';
        saveItems(); saveSavings(); refreshAll(); toast('已清空，页面回到初始状态');
      });
    }
  });
  $('burger').addEventListener('click', function(){ $('mobileNav').classList.toggle('open'); });
  $('addToggle').addEventListener('click', function(){ $('addPanel').classList.toggle('open'); });
  $('fSubmit').addEventListener('click', function(){
    var name = $('fName').value.trim();
    var cat = $('fCat').value;
    if(!name){ toast('先给单品起个名字吧'); $('fName').focus(); return; }
    var styles = [];
    var boxes = $('fStyles').querySelectorAll('input:checked');
    for(var i=0;i<boxes.length;i++) styles.push(boxes[i].value);
    var sub = $('fSub').value;
    if(cat==='makeup'||cat==='skincare') sub = cat;
    if(cat==='accessory') sub = 'accessory';
    var item = {
      id: 'u' + Date.now() + Math.floor(Math.random()*999),
      name:name, cat:cat, subType:sub,
      color: $('fColor').value.trim(), price: Number($('fPrice').value)||0,
      styles: styles, worn: Number($('fWorn').value)||0
    };
    if((cat==='skincare'||cat==='makeup') && $('fOpened').value && $('fPao').value){
      item.openedAt = $('fOpened').value; item.paoMonths = Number($('fPao').value);
    }
    state.items.push(item);
    state.ui.activeCat = cat;
    saveItems(); saveUI(); refreshAll();
    resetForm(); toast('已收进百宝箱：'+name);
  });
  function resetForm(){
    $('fName').value=''; $('fColor').value=''; $('fPrice').value=''; $('fWorn').value='';
    $('fOpened').value=''; $('fPao').value=''; $('fSub').value='';
    var boxes = $('fStyles').querySelectorAll('input');
    for(var i=0;i<boxes.length;i++) boxes[i].checked = false;
  }
  $('fReset').addEventListener('click', resetForm);
  $('sAdd').addEventListener('click', function(){
    var name = $('sName').value.trim(), amount = Number($('sAmount').value), type = $('sType').value;
    if(!name){ toast('写一下是什么吧'); $('sName').focus(); return; }
    if(!amount || amount<=0){ toast('金额要大于 0 才有成就感'); $('sAmount').focus(); return; }
    state.savings.push({ id:'sv'+Date.now(), date:todayStr(), name:name, amount:amount, type:type });
    saveSavings(); refreshAll();
    $('sName').value=''; $('sAmount').value='';
    toast(type==='earned' ? '回血 '+money(amount)+'，循环时尚人就是你了' : '又忍住 '+money(amount)+'，冷静值 +1');
  });
  $('cpwSelect').addEventListener('change', function(){ state.ui.cpwId = this.value; saveUI(); renderSavings(); });
  $('fileInput').addEventListener('change', function(){
    var f = this.files && this.files[0]; if(!f) return;
    var reader = new FileReader();
    reader.onload = function(){
      try{
        var data = JSON.parse(reader.result);
        if(!data || !Array.isArray(data.items) || !Array.isArray(data.savings)) throw new Error('格式不对');
        state.items = data.items; state.savings = data.savings;
        saveItems(); saveSavings(); refreshAll();
        toast('导入成功：'+state.items.length+' 件单品、'+state.savings.length+' 条记录');
      }catch(err){ toast('导入失败：文件不是有效的备份 JSON'); }
      $('fileInput').value = '';
    };
    reader.readAsText(f);
  });
  $('modalCancel').addEventListener('click', closeModal);
  $('modalOk').addEventListener('click', function(){ var cb = modalCb; closeModal(); if(cb) cb(); });
  $('modalMask').addEventListener('click', function(e){ if(e.target===this) closeModal(); });
}
function exportJSON(){
  var data = { app:'stylehub', version:1, exportedAt:new Date().toISOString(), items:state.items, savings:state.savings };
  var blob = new Blob([JSON.stringify(data,null,2)], {type:'application/json'});
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'stylehub-backup-'+todayStr()+'.json';
  document.body.appendChild(a); a.click();
  setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 300);
  toast('备份已导出，请妥善保存 JSON 文件');
}

/* ================= 初始化 ================= */
function init(){
  loadAll();
  renderTicker();
  renderHeroStage();
  renderStyleChecks();
  renderDeals();
  bindEvents();
  refreshAll();
}
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init);
else init();
</script>
</body>
