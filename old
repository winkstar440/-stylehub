  }).slice(0,3);
}
function savings7d(){
  var days = [], base = new Date(); base.setHours(0,0,0,0);
  for(var i=6;i>=0;i--){
    var d = new Date(base.getTime()-i*86400000);
    var key = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    var sum = 0;
    state.savings.forEach(function(s){ if(s.date===key) sum += (s.amount||0); });
    days.push({ key:key, label:(d.getMonth()+1)+'/'+d.getDate(), sum:sum });
  }
  return days;
}

